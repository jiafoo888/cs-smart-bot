# Local demo / deploy defaults (no secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=true
USE_MCP_STDIO=false
DATABASE_URL=sqlite+aiosqlite:///./data/cs_bot.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=hash
VECTOR_STORE=simple
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=90
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
COMPANY_NAME=SteelShop
HOST=0.0.0.0
PORT=8000
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cs-smart-bot
